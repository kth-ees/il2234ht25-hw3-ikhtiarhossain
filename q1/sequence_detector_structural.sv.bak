module sequence_detector_structural (
    input logic clk,
    input logic rst_n,
    input logic input_sequence,
    output logic detected
);

    logic d2, d1, d0, q2, q1, q0; // next and present states

    // DFF
    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            q2 <= 0;
            q1 <= 0;
            q0 <= 0;
        end else begin
            q2 <= d2;
            q1 <= d1;
            q0 <= d0;
        end
    end

        assign d2 = (input_sequence & q2) | (input_sequence & q1 & q0);
        assign d1 = (input_sequence & q1 & ~q0) | (input_sequence & ~q2 & ~q1 & q0);
        assign d0 = (input_sequence & ~q2 & ~q0) | (input_sequence & q2);
        assign detected = input_sequence & q2;

endmodule

