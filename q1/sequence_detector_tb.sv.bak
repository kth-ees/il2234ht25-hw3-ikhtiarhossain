`timescale 1ns/1ps
module sequence_detector_tb;

    logic clk;
    logic rst_n;
    logic input_sequence;
    logic detected_behavioral;
    logic detected_structural;

    sequence_detector_behavioral uut (
        .clk(clk),
        .rst_n(rst_n),
        .input_sequence(input_sequence),
        .detected(detected_behavioral)
    );

    sequence_detector_structural uut2 (
        .clk(clk),
        .rst_n(rst_n),
        .input_sequence(input_sequence),
        .detected(detected_structural)
    );

    initial clk = 0;
    always #5 clk = ~clk;

    initial begin
        rst_n = 0;
        input_sequence = 0;
        #12 rst_n = 1;

        @(negedge clk); input_sequence = 1;
        @(negedge clk); input_sequence = 0;

        @(negedge clk); input_sequence = 1;
        @(negedge clk); input_sequence = 1;
        @(negedge clk); input_sequence = 0;

        @(negedge clk); input_sequence = 1;
        @(negedge clk); input_sequence = 1;
        @(negedge clk); input_sequence = 1;
        @(negedge clk); input_sequence = 0;
        
        @(negedge clk); input_sequence = 1;
        @(negedge clk); input_sequence = 1;
        @(negedge clk); input_sequence = 1;
        @(negedge clk); input_sequence = 1;
        @(negedge clk); input_sequence = 1;
        @(negedge clk); input_sequence = 0;

        @(negedge clk); input_sequence = 1;
        @(negedge clk); input_sequence = 1;
        @(negedge clk); input_sequence = 1;
        @(negedge clk); input_sequence = 1;
        @(negedge clk); input_sequence = 1;
        @(negedge clk); input_sequence = 1;
        @(negedge clk); input_sequence = 0;

        @(negedge clk); input_sequence = 1;
        @(negedge clk); input_sequence = 1;
        @(negedge clk); input_sequence = 1;
        @(negedge clk); input_sequence = 1;
        @(negedge clk); input_sequence = 1;
        @(negedge clk); input_sequence = 1;
        @(negedge clk); input_sequence = 1;
        @(negedge clk); input_sequence = 0;

        #20 $stop;
    end

    always @(posedge clk) begin
        if (detected_behavioral !== detected_structural)
            $display("Mismatch at time %0t: behavioral=%b, structural=%b, input=%b",
                     $time, detected_behavioral, detected_structural, input_sequence);
    end

endmodule